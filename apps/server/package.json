{
  "name": "@lets-secureride-ai/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node dist/server.js",
    "start:local": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "auth:indexes": "node dist/scripts/auth-indexes.js"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "compression": "1.8.1",
    "cookie": "2.0.1",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jose": "6.2.10",
    "mongoose": "9.9.4",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@lets-secureride-ai/contracts": "0.0.0",
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "vitest": "4.1.11"
  }
}
