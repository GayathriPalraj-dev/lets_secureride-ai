NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Required server-only database configuration. Intentionally fake and rejected until replaced privately.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST.invalid/lets_secureride_ai?retryWrites=true&w=majority

# Future steps only; not validated or used by Step 3.
STRIPE_SECRET_KEY=replace_later
STRIPE_WEBHOOK_SECRET=replace_later
AWS_REGION=ap-south-1
AWS_S3_MEDIA_BUCKET=replace_later

# Step 4: configure privately; placeholders below deliberately fail startup validation.
JWT_ACCESS_SECRET=<GENERATE_PRIVATELY>
JWT_ACCESS_KEY_ID=<CHOOSE_KEY_IDENTIFIER>
JWT_ISSUER=<CHOOSE_ISSUER>
JWT_AUDIENCE=<CHOOSE_AUDIENCE>
AUTH_RATE_LIMIT_SECRET=<GENERATE_INDEPENDENTLY>
# Optional paired rotation variables: JWT_ACCESS_PREVIOUS_SECRET, JWT_ACCESS_PREVIOUS_KEY_ID
AUTH_ACCESS_TTL_SECONDS=300
AUTH_REFRESH_IDLE_SECONDS=604800
AUTH_REFRESH_ABSOLUTE_SECONDS=2592000
